<%# Une valeur corrigée dans un onglet renvoie toute la fiche : elle se remplace d'un seul id. %>
<%= tag.div id: dom_id(@simulation) do %>
  <%= render "simulations/detail", simulation: @simulation, projections: @projections, schedule: @schedule, tab: @tab %>
<% end %>

<div class="form-actions">
  <%= link_to t("views.simulations.show.back"), simulations_path, class: "btn btn-outline" %>
  <%= button_to t("views.simulations.show.delete"), simulation_path(@simulation), method: :delete, class: "btn btn-danger",
      form: { data: { turbo_confirm: t("views.simulations.show.confirm_delete") } } %>
</div>
