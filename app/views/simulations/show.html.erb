<div class="page-header">
  <div>
    <h1><%= @simulation.name %></h1>
    <p class="page-header-hint"><%= t("views.simulations.show.subtitle", date: l(@simulation.purchase_date, format: :long)) %></p>
  </div>
  <div class="page-header-actions">
    <%= link_to t("views.simulations.show.edit"), edit_simulation_path(@simulation), class: "btn btn-primary" %>
  </div>
</div>

<%# Deux lectures de la même simulation : ses paramètres d'un côté, sa projection de l'autre.
    Les deux panneaux sont rendus par le serveur ; l'onglet choisit lequel se montre. %>
<div data-controller="tabs" data-tabs-index-value="0">
  <div class="tabs" role="tablist">
    <button type="button" class="tab" role="tab" id="tab-parameters"
            aria-controls="panel-parameters" aria-selected="true"
            data-tabs-target="tab" data-action="click->tabs#select">
      <%= t("views.simulations.show.tab_parameters") %>
    </button>
    <button type="button" class="tab" role="tab" id="tab-projection"
            aria-controls="panel-projection" aria-selected="false"
            data-tabs-target="tab" data-action="click->tabs#select">
      <%= t("views.simulations.show.tab_projection", years: Simulation::HORIZON_YEARS) %>
    </button>
  </div>

  <div class="tab-panel" role="tabpanel" id="panel-parameters" aria-labelledby="tab-parameters" data-tabs-target="panel">
    <%= render "parameters", simulation: @simulation %>
  </div>

  <div class="tab-panel" role="tabpanel" id="panel-projection" aria-labelledby="tab-projection" data-tabs-target="panel" hidden>
    <%= render "projection", simulation: @simulation, projection: @projection %>
  </div>
</div>

<div class="form-actions">
  <%= link_to t("views.simulations.show.back"), simulations_path, class: "btn btn-outline" %>
  <%= button_to t("views.simulations.show.delete"), simulation_path(@simulation), method: :delete, class: "btn btn-danger",
      form: { data: { turbo_confirm: t("views.simulations.show.confirm_delete") } } %>
</div>
