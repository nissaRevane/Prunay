<%# Les frais de notaire : un montant qu'on lit, pas un champ qu'on remplit. Le contrôleur
    `notary-fees` les recalcule à la frappe depuis le prix. %>
<div class="form-group">
  <span class="form-label"><%= Simulation.human_attribute_name(:notary_fees) %></span>
  <p class="form-static" data-notary-fees-target="amount"><%= number_to_currency(simulation.notary_fees) %></p>
</div>
