<%# Le calcul d'une ligne, replié tant qu'on n'a pas demandé à le voir. %>
<% if lines.any? %>
  <div class="detail-breakdown" data-statement-target="detail" hidden>
    <% lines.each do |label, amount| %>
      <div class="detail-item">
        <span class="detail-label"><%= label %></span>
        <span class="detail-value"><%= number_to_currency(amount) %></span>
      </div>
    <% end %>
  </div>
<% end %>
