<div data-controller="notary-fees"
     data-notary-fees-rate-value="<%= Simulation::NOTARY_FEES_RATE.to_f %>"
     data-notary-fees-base-value="<%= Simulation::NOTARY_FEES_BASE %>">
  <div class="form-group">
    <%= f.label :purchase_price %>
    <%= f.number_field :purchase_price, step: "0.01", min: "0", class: "form-control", required: true, autofocus: true,
        data: { notary_fees_target: "price", action: "input->notary-fees#refresh" } %>
  </div>

  <%= render "simulations/notary_fees", simulation: f.object %>
</div>

<div class="form-group">
  <%= f.label :initial_works %>
  <%= f.number_field :initial_works, step: "0.01", min: "0", class: "form-control", required: true %>
  <p class="form-hint"><%= t("views.simulations.steps.purchase.initial_works_hint") %></p>
</div>

<div class="form-group">
  <%= f.label :purchase_date %>
  <%= f.date_field :purchase_date, class: "form-control", required: true %>
  <p class="form-hint"><%= t("views.simulations.steps.purchase.purchase_date_hint") %></p>
</div>
