<%= tag.div data: { controller: "lots", **lots_values } do %>
  <% if f.object.divided_into_lots? %>
    <%= render "simulations/lot_letting_fields", f: f, surfaces: true, template: false %>
  <% end %>

  <div class="form-group">
    <%= f.label :monthly_rent %>
    <%= f.number_field :monthly_rent, step: "0.01", min: "0", class: "form-control", required: true,
        autofocus: !f.object.divided_into_lots?, data: { lots_target: "totalRent" },
        **lot_total_options(f.object, :monthly_rent) %>

    <% if f.object.divided_into_lots? %>
      <%= lot_total_hint(f.object, :monthly_rent) %>
    <% else %>
      <%= render "simulations/rent_reference", simulation: f.object %>
    <% end %>
  </div>

  <div class="form-group">
    <%= f.label :monthly_charges %>
    <%= f.number_field :monthly_charges, step: "0.01", min: "0", class: "form-control", required: true,
        data: { lots_target: "totalCharges" }, **lot_total_options(f.object, :monthly_charges) %>
    <%= lot_total_hint(f.object, :monthly_charges) %>
  </div>

  <div class="form-group">
    <%= f.label :occupancy_months %>
    <%= f.number_field :occupancy_months, step: "0.5", min: "0", max: Simulation::MONTHS_PER_YEAR, class: "form-control",
        required: true, data: { lots_target: "totalMonths" }, **lot_total_options(f.object, :occupancy_months) %>
    <%= lot_total_hint(f.object, :occupancy_months) %>
  </div>
<% end %>

<div class="form-group">
  <%= f.label :rental_start_date %>
  <%= f.date_field :rental_start_date, class: "form-control", required: true %>
</div>
