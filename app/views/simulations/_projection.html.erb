<%# L'onglet titre déjà la projection, et le tableau s'en tient à ce qu'on y cherche : ce que
    l'année déclare, ce qu'elle laisse et ce qui reste engagé. Le loyer y est hors charges — la
    provision n'est pas un revenu. Le clic sur une ligne ouvre le compte de résultat de l'année,
    du loyer au cash-flow. %>
<div class="section" data-controller="projection">
  <div class="table-scroll">
    <table class="table">
      <thead>
        <tr>
          <th><%= t("views.simulations.show.year") %></th>
          <th><%= t("views.simulations.show.date") %></th>
          <th class="text-right"><%= t("views.simulations.show.annual_rent_column") %></th>
          <th class="text-right"><%= t("views.simulations.show.cash_flow") %></th>
          <th class="text-right"><%= t("views.simulations.show.immobilized_capital") %></th>
        </tr>
      </thead>
      <tbody>
        <% projection.years.each do |year| %>
          <tr class="row-expandable" data-action="click->projection#open"
              data-projection-year-param="<%= year.number %>">
            <td>
              <%# Le bouton est là pour le clavier ; le clic sur la ligne entière remonte
                  jusqu'à elle et ouvre la même fiche. %>
              <button type="button" class="row-toggle" aria-haspopup="dialog"
                      aria-controls="<%= projection.regime %>-year-<%= year.number %>-statement"><%= year.number %></button>
            </td>
            <td><%= l(year.date, format: :month_year) %></td>
            <td class="text-right"><%= number_to_currency(year.rent_excluding_charges) %></td>
            <td class="text-right <%= year.cash_flow.negative? ? 'text-danger' : 'text-success' %>"><%= number_to_currency(year.cash_flow) %></td>
            <td class="text-right <%= year.recovered? ? 'text-success' : 'text-danger' %>">
              <%= number_to_currency(year.immobilized_capital) %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>

  <div class="section-total">
    <span><%= t("views.simulations.show.total_cash_flow", years: Projection::HORIZON_YEARS) %></span>
    <span><%= number_to_currency(projection.total_cash_flow) %></span>
  </div>

  <div class="section-total">
    <span><%= t("views.simulations.show.final_property_value", years: Projection::HORIZON_YEARS) %></span>
    <span><%= number_to_currency(projection.final_property_value) %></span>
  </div>

  <%# Une fiche par année, rendue avec le tableau et ouverte par lui : les charges se lisent
      en négatif, comme sur un compte de résultat, et chaque solde suit ce qui l'a produit. Le
      régime préfixe les identifiants — les deux onglets sont sur la même page. %>
  <% projection.years.each do |year| %>
    <dialog class="statement" id="<%= projection.regime %>-year-<%= year.number %>-statement" data-projection-target="statement"
            data-year="<%= year.number %>" data-action="click->projection#dismiss"
            aria-labelledby="<%= projection.regime %>-year-<%= year.number %>-statement-title">
      <div class="statement-header">
        <div>
          <div class="statement-title" id="<%= projection.regime %>-year-<%= year.number %>-statement-title">
            <%= t("views.simulations.show.statement_title", year: year.number) %>
          </div>
          <div class="statement-date"><%= l(year.date, format: :long) %></div>
        </div>
        <button type="button" class="statement-close" data-action="click->projection#close"
                aria-label="<%= t("views.simulations.show.statement_close") %>">&times;</button>
      </div>

      <div class="statement-lines">
        <div class="statement-line">
          <span class="statement-label"><%= t("views.simulations.show.annual_rent_column") %></span>
          <span class="statement-amount"><%= number_to_currency(year.rent_excluding_charges) %></span>
        </div>
        <div class="statement-line">
          <%# La provision remboursée est déjà ôtée des charges : la note dit pourquoi elles
              sont plus légères que celles du formulaire, sans faire une ligne du compte. %>
          <span class="statement-label">
            <%= t("views.simulations.show.annual_charges_column") %>
            <% if year.provision_for_charges.positive? %>
              <span class="statement-note"><%= t("views.simulations.show.provision_deducted",
                                                 amount: number_to_currency(year.provision_for_charges)) %></span>
            <% end %>
          </span>
          <span class="statement-amount"><%= number_to_currency(-year.charges_excluding_provision) %></span>
        </div>
        <div class="statement-line">
          <span class="statement-label"><%= t("views.simulations.show.loan_interest_column") %></span>
          <span class="statement-amount"><%= number_to_currency(-year.loan_interest) %></span>
        </div>
        <div class="statement-line statement-line-subtotal">
          <span class="statement-label"><%= t("views.simulations.show.pre_tax_result") %></span>
          <span class="statement-amount"><%= number_to_currency(year.pre_tax_result) %></span>
        </div>
        <div class="statement-line">
          <span class="statement-label"><%= t("views.simulations.show.annual_taxes_column") %></span>
          <span class="statement-amount"><%= number_to_currency(-year.taxes) %></span>
        </div>
        <div class="statement-line statement-line-subtotal">
          <span class="statement-label"><%= t("views.simulations.show.net_result") %></span>
          <span class="statement-amount"><%= number_to_currency(year.net_result) %></span>
        </div>
        <div class="statement-line">
          <span class="statement-label"><%= t("views.simulations.show.capital_repayment_column") %></span>
          <span class="statement-amount"><%= number_to_currency(-year.capital_repayment) %></span>
        </div>
        <div class="statement-line statement-line-total">
          <span class="statement-label"><%= t("views.simulations.show.cash_flow") %></span>
          <span class="statement-amount <%= year.cash_flow.negative? ? 'text-danger' : 'text-success' %>">
            <%= number_to_currency(year.cash_flow) %>
          </span>
        </div>
      </div>
    </dialog>
  <% end %>
</div>
