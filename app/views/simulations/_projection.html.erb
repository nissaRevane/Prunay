<%# Ce que l'année déclare, ce qu'elle laisse et ce qui reste engagé. Le clic sur une ligne
    demande au serveur la fiche de l'année, qui vient se ranger ici. %>
<div class="section" data-controller="projection"
     data-projection-url-value="<%= statement_simulation_path(projection.simulation, regime: projection.regime) %>">
  <div class="table-scroll">
    <table class="table">
      <thead>
        <tr>
          <th><%= t("views.simulations.show.year") %></th>
          <th><%= t("views.simulations.show.date") %></th>
          <th class="num"><%= t("views.simulations.show.#{projection.rent_column}") %></th>
          <th class="num"><%= t("views.simulations.show.cash_flow") %></th>
          <th class="num"><%= t("views.simulations.show.immobilized_capital") %></th>
          <th class="num"><%= t("views.simulations.show.internal_rate_of_return") %></th>
        </tr>
      </thead>
      <tbody>
        <% projection.years.each do |year| %>
          <tr class="row-expandable" data-action="click->projection#open"
              data-projection-year-param="<%= year.number %>">
            <td>
              <button type="button" class="row-toggle" aria-haspopup="dialog"><%= year.number %></button>
            </td>
            <td><%= l(year.date, format: :month_year) %></td>
            <td class="num"><%= euros(projection.rent_of(year)) %></td>
            <td class="num <%= tone(year.cash_flow) %>"><%= euros(year.cash_flow) %></td>
            <td class="num"><%= euros(year.immobilized_capital) %></td>
            <% rate = projection.internal_rate_of_return(year) %>
            <td class="num <%= rate_tone(rate) %>"><%= internal_rate_of_return_label(rate) %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
  <div data-projection-target="statements"></div>
</div>
