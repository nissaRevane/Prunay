<%# Une ligne que le clic ouvre : le champ prend la place du texte et part seul. Aucun bouton —
    la valeur revenue du serveur est la confirmation. %>
<%= tag.div class: "detail-item", hidden: regimes.present?,
            data: { controller: "inline-edit" }.merge(regimes ? regime_scope(regimes) : {}) do %>
  <dt class="detail-label"><%= label %></dt>
  <dd class="<%= class_names("detail-value", value_class) %>">
    <button type="button" class="inline-edit-display" data-inline-edit-target="display"
            data-action="inline-edit#open"><%= value %></button>

    <%= inline_edit_form(simulation, url) do |f| %>
      <%= yield f %>
    <% end %>

    <% if note %>
      <span class="detail-note"><%= note %></span>
    <% end %>
  </dd>
<% end %>
