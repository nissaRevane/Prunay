<%# Les lots d'un immeuble, côté location : un loyer par lot, proposé selon sa surface. %>
<% building = f.object.building? %>
<%= tag.div class: "form-group", hidden: !building, data: { lots_target: "editor" } do %>
  <div class="assumption-grid" data-lots-target="rentList">
    <% f.object.lots.each_with_index do |lot, index| %>
      <%= render "simulations/lot_rent", f: f, lot: lot, index: index, number: index + 1, surfaces: surfaces,
                                         disabled: !building %>
    <% end %>
  </div>
<% end %>

<% if template %>
  <template data-lots-target="rentTemplate">
    <%= render "simulations/lot_rent", f: f, lot: {}, index: "__INDEX__", number: nil, surfaces: false, disabled: false %>
  </template>
<% end %>
