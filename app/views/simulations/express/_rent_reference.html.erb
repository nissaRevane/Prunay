<%= turbo_frame_tag "rent_reference", class: "form-reference", data: { rent_estimate_target: "frame" } do %>
  <%= render "simulations/rent_reference", simulation: simulation %>

  <% if simulation.city.present? && simulation.surface.present? %>
    <%= tag.span hidden: true, data: { rent_estimate_placeholder: t("views.simulations.express.monthly_rent_estimate",
                                                                    amount: euros(simulation.proposed_rent)) } %>
  <% end %>
<% end %>
