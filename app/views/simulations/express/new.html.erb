<div class="home">
  <div class="home-form">
    <%= turbo_frame_tag "express_form" do %>
      <%= render "simulations/express/form", simulation: @simulation %>
    <% end %>
  </div>

  <% if @recent.any? %>
    <section class="recent-simulations">
      <%= render partial: "simulations/card", collection: @recent, as: :simulation %>

      <%= link_to t("views.simulations.express.all"), simulations_path,
          class: "panel panel-link recent-simulations-all" %>
    </section>
  <% end %>
</div>
