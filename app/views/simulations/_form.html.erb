<%# Le formulaire de modification : les quatre pages de la création rassemblées en une
    seule, chacune devenue un groupe. Qui vient corriger un chiffre n'a pas à retraverser
    l'assistant. %>
<%= form_with(model: simulation, class: "form", data: { controller: "charges" }) do |f| %>
  <%= render "shared/errors", resource: simulation %>

  <fieldset class="form-fieldset">
    <legend><%= t("views.simulations.steps.property.title") %></legend>

    <div class="form-group">
      <%= f.label :name %>
      <%= f.text_field :name, class: "form-control" %>
      <p class="form-hint"><%= t("views.simulations.steps.property.name_hint") %></p>
    </div>

    <div class="form-group">
      <%= f.label :property_type %>
      <%= f.select :property_type, property_type_options, {}, class: "form-control", required: true %>
    </div>

    <div class="form-row">
      <div class="form-group form-group-half">
        <%= f.label :city %>
        <%= f.text_field :city, class: "form-control", required: true %>
      </div>

      <div class="form-group form-group-half">
        <%= f.label :address %>
        <%= f.text_field :address, class: "form-control" %>
      </div>
    </div>

    <div class="form-row">
      <div class="form-group form-group-half">
        <%= f.label :surface %>
        <%= f.number_field :surface, step: "0.01", min: "0", class: "form-control", required: true %>
      </div>

      <div class="form-group form-group-half">
        <%= f.label :energy_rating %>
        <%= f.select :energy_rating, energy_rating_options, { include_blank: t("views.simulations.steps.property.energy_rating_blank") }, class: "form-control" %>
      </div>
    </div>

    <div class="form-group form-check">
      <%= f.check_box :condominium, data: { charges_target: "condominium", action: "change->charges#refresh" } %>
      <%= f.label :condominium %>
    </div>
  </fieldset>

  <fieldset class="form-fieldset">
    <legend><%= t("views.simulations.steps.purchase.title") %></legend>

    <div data-controller="notary-fees"
         data-notary-fees-rate-value="<%= Simulation::NOTARY_FEES_RATE.to_f %>"
         data-notary-fees-base-value="<%= Simulation::NOTARY_FEES_BASE %>">
      <div class="form-row">
        <div class="form-group form-group-half">
          <%= f.label :purchase_price %>
          <%= f.number_field :purchase_price, step: "0.01", min: "0", class: "form-control", required: true,
              data: { notary_fees_target: "price", action: "input->notary-fees#refresh" } %>
        </div>

        <div class="form-group form-group-half">
          <%= f.label :initial_works %>
          <%= f.number_field :initial_works, step: "0.01", min: "0", class: "form-control", required: true %>
        </div>
      </div>

      <%= render "simulations/notary_fees", simulation: f.object %>
    </div>

    <div class="form-group">
      <%= f.label :purchase_date %>
      <%= f.date_field :purchase_date, class: "form-control", required: true %>
    </div>
  </fieldset>

  <fieldset class="form-fieldset">
    <legend><%= t("views.simulations.steps.rental.title") %></legend>

    <div class="form-row">
      <div class="form-group form-group-half">
        <%= f.label :monthly_rent %>
        <%= f.number_field :monthly_rent, step: "0.01", min: "0", class: "form-control", required: true %>
      </div>

      <div class="form-group form-group-half">
        <%= f.label :occupancy_months %>
        <%= f.number_field :occupancy_months, step: "0.5", min: "0", max: Simulation::MONTHS_PER_YEAR, class: "form-control", required: true %>
      </div>
    </div>

    <div class="form-group">
      <%= f.label :rental_type %>
      <%= f.select :rental_type, rental_type_options, {}, class: "form-control", required: true,
          data: { charges_target: "rentalType", action: "change->charges#refresh" } %>
    </div>
  </fieldset>

  <fieldset class="form-fieldset">
    <legend><%= t("views.simulations.steps.charges.title") %></legend>

    <%= render "simulations/charge_fields", f: f %>
  </fieldset>

  <div class="form-actions">
    <%= f.submit class: "btn btn-primary" %>
    <%= link_to t("views.simulations.form.cancel"), simulations_path, class: "btn btn-outline" %>
  </div>
<% end %>
