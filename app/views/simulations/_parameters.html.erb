<%# Les hypothèses de la simulation : le bien, ce que sa signature coûte et ce qu'il dépense
    chaque année. C'est ce que l'on relit avant de croire à la projection, et chaque valeur
    saisie s'y corrige d'un clic. Ce qui se calcule, lui, ne se clique pas. %>
<div class="section">
  <div class="section-header">
    <h2><%= t("views.simulations.show.property") %></h2>
  </div>

  <dl class="detail-grid">
    <%= editable_detail simulation, :property_type, t("simulations.property_types.#{simulation.property_type}") do |f| %>
      <%= f.select :property_type, property_type_options, {}, class: "form-control" %>
    <% end %>

    <%= editable_detail simulation, :city, simulation.city do |f| %>
      <%= f.text_field :city, class: "form-control", required: true %>
    <% end %>

    <%= editable_detail simulation, :address, simulation.address.presence || t("views.simulations.show.not_provided") do |f| %>
      <%= f.text_field :address, class: "form-control" %>
    <% end %>

    <%= editable_detail simulation, :surface, t("views.simulations.show.surface_value", surface: number_with_precision(simulation.surface, precision: 2, strip_insignificant_zeros: true)) do |f| %>
      <%= f.number_field :surface, step: "0.01", min: "0", class: "form-control", required: true %>
    <% end %>

    <%= editable_detail simulation, :energy_rating, simulation.energy_rating.presence || t("views.simulations.show.not_provided") do |f| %>
      <%= f.select :energy_rating, energy_rating_options,
          { include_blank: t("views.simulations.steps.property.energy_rating_blank") }, class: "form-control" %>
    <% end %>

    <%= editable_detail simulation, :condominium, t("views.simulations.show.#{simulation.condominium? ? 'answer_yes' : 'answer_no'}") do |f| %>
      <%= f.select :condominium, answer_options, {}, class: "form-control" %>
    <% end %>
  </dl>
</div>

<%# Le prix, les frais de notaire qu'il entraîne et les travaux à engager avant la première location. %>
<div class="section">
  <div class="section-header">
    <h2><%= t("views.simulations.show.purchase_detail") %></h2>
  </div>

  <dl class="detail-grid">
    <%= editable_detail simulation, :purchase_price, number_to_currency(simulation.purchase_price) do |f| %>
      <%= f.number_field :purchase_price, step: "0.01", min: "0", class: "form-control", required: true %>
    <% end %>

    <div class="detail-item">
      <dt class="detail-label"><%= Simulation.human_attribute_name(:notary_fees) %></dt>
      <dd class="detail-value"><%= number_to_currency(simulation.notary_fees) %></dd>
    </div>

    <%= editable_detail simulation, :initial_works, number_to_currency(simulation.initial_works) do |f| %>
      <%= f.number_field :initial_works, step: "0.01", min: "0", class: "form-control", required: true %>
    <% end %>

    <%= editable_detail simulation, :purchase_date, l(simulation.purchase_date, format: :long) do |f| %>
      <%= f.date_field :purchase_date, class: "form-control", required: true %>
    <% end %>
  </dl>

  <div class="section-total">
    <span><%= t("views.simulations.show.project_cost") %></span>
    <span><%= number_to_currency(simulation.total_investment) %></span>
  </div>
</div>

<% if simulation.credit? %>
  <%= render "credit", simulation: simulation %>
<% end %>

<%# Le loyer est saisi au mois, comme un bail l'énonce : hors charges d'un côté, provision de l'autre. %>
<div class="section">
  <div class="section-header">
    <h2><%= t("views.simulations.show.rental_detail") %></h2>
  </div>

  <dl class="detail-grid">
    <%= editable_detail simulation, :monthly_rent, number_to_currency(simulation.monthly_rent), value_class: "text-success" do |f| %>
      <%= f.number_field :monthly_rent, step: "0.01", min: "0", class: "form-control", required: true %>
    <% end %>

    <%= editable_detail simulation, :monthly_charges, number_to_currency(simulation.monthly_charges) do |f| %>
      <%= f.number_field :monthly_charges, step: "0.01", min: "0", class: "form-control", required: true %>
    <% end %>

    <%= editable_detail simulation, :occupancy_months, t("views.simulations.show.occupancy_value", months: number_with_precision(simulation.occupancy_months, precision: 1, strip_insignificant_zeros: true)) do |f| %>
      <%= f.number_field :occupancy_months, step: "0.5", min: "0", max: Simulation::MONTHS_PER_YEAR,
          class: "form-control", required: true %>
    <% end %>
  </dl>

  <div class="section-total">
    <span><%= t("views.simulations.show.annual_rent_total") %></span>
    <span><%= number_to_currency(simulation.annual_rent) %></span>
  </div>
</div>

<div class="section">
  <div class="section-header">
    <h2><%= t("views.simulations.show.charges_detail") %></h2>
  </div>

  <%# Une maison n'affiche pas de charges de copropriété : une ligne à zéro se lirait comme un oubli. %>
  <dl class="detail-grid">
    <% simulation.applicable_charges.each do |charge| %>
      <%= editable_detail simulation, charge, number_to_currency(simulation.public_send(charge)) do |f| %>
        <%= f.number_field charge, step: "0.01", min: "0", class: "form-control", required: true %>
      <% end %>
    <% end %>

    <%# La CFE ne se saisit pas et ne vaut que meublé : la note le dit à même le libellé. %>
    <div class="detail-item">
      <dt class="detail-label">
        <%= t("views.simulations.show.business_tax") %>
        <span class="detail-note"><%= t("views.simulations.show.business_tax_hint") %></span>
      </dt>
      <dd class="detail-value"><%= number_to_currency(simulation.annual_business_tax) %></dd>
    </div>
  </dl>

  <div class="section-total">
    <span><%= t("views.simulations.show.annual_charges_total") %></span>
    <span><%= number_to_currency(simulation.annual_charges) %></span>
  </div>
</div>
