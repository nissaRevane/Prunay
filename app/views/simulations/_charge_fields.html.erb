<%# Les charges annuelles dans l'ordre que `Simulation::CHARGE_GROUPS` fixe : une charge de plus
    s'ajoute au modèle, pas ici. Celles de copropriété ne se demandent que sous condition, et le
    serveur rend l'état juste dès le premier affichage — `hidden` écarte le champ, `disabled` sa
    saisie, car un champ requis et invisible bloquerait l'envoi. Sur le formulaire de modification
    le contrôleur `charges` reprend la main à chaque changement ; dans l'assistant, rien ne bouge. %>
<% autofocus = local_assigns.fetch(:autofocus, false) %>

<% Simulation::CHARGE_GROUPS.each do |group, fields| %>
  <div class="charge-group">
    <p class="charge-group-title"><%= t("views.simulations.charges.groups.#{group}.title") %></p>

    <% fields.each_slice(2) do |row| %>
      <div class="form-row">
        <% row.each do |field| %>
          <% applicable = f.object.charge_applicable?(field) %>
          <%= tag.div class: "form-group form-group-half", hidden: !applicable,
                      data: { charges_condition: charge_condition_name(field) } do %>
            <%= f.label field %>
            <%= f.number_field field, step: "0.01", min: "0", class: "form-control",
                required: true, disabled: !applicable,
                autofocus: autofocus && field == Simulation::ANNUAL_CHARGES.first %>
          <% end %>
        <% end %>
      </div>
    <% end %>
  </div>
<% end %>
