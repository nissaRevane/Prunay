<%# Les charges annuelles dans l'ordre de Simulation::CHARGE_GROUPS : une charge de plus
    s'ajoute au modèle, pas ici. %>
<% autofocus = local_assigns.fetch(:autofocus, false) %>

<% Simulation::CHARGE_GROUPS.each do |group, fields| %>
  <div class="charge-group">
    <p class="charge-group-title"><%= t("views.simulations.charges.groups.#{group}.title") %></p>

    <% fields.each_slice(2) do |row| %>
      <div class="form-row">
        <% row.each do |field| %>
          <div class="form-group form-group-half">
            <%= f.label field %>
            <%= f.number_field field, step: "0.01", min: "0", class: "form-control", required: true,
                autofocus: autofocus && field == Simulation::ANNUAL_CHARGES.first %>
          </div>
        <% end %>
      </div>
    <% end %>
  </div>
<% end %>
