<%# Les lots d'un immeuble, chaque valeur corrigeable d'un clic comme le reste de la fiche. %>
<div class="section">
  <div class="section-header">
    <h2><%= t("views.simulations.show.lots_detail") %></h2>
  </div>

  <div class="table-scroll">
    <table class="table">
      <thead>
        <tr>
          <th><%= t("views.simulations.lots.lot") %></th>
          <% Simulation::LOT_FIELDS.each do |field| %>
            <th class="num"><%= t("views.simulations.lots.columns.#{field}") %></th>
          <% end %>
        </tr>
      </thead>
      <tbody>
        <% simulation.lots.each_index do |index| %>
          <tr>
            <td><%= t("views.simulations.lots.number", number: index + 1) %></td>
            <% Simulation::LOT_FIELDS.each do |field| %>
              <%= editable_lot_cell simulation, index, field %>
            <% end %>
          </tr>
        <% end %>
      </tbody>
      <tfoot>
        <tr>
          <td><%= t("views.simulations.lots.total") %></td>
          <% Simulation::LOT_FIELDS.each do |field| %>
            <td class="num"><%= lot_figure(field, simulation.public_send(field)) %></td>
          <% end %>
        </tr>
      </tfoot>
    </table>
  </div>
</div>
