<table class="table">
  <thead>
    <tr>
      <th><%= t("views.simulations.index.name") %></th>
      <th class="hide-on-mobile"><%= t("views.simulations.index.purchase_date") %></th>
      <th class="hide-on-mobile"><%= t("views.simulations.index.total_investment") %></th>
      <th><%= t("views.simulations.index.annual_cash_flow") %></th>
      <th></th>
    </tr>
  </thead>
  <tbody>
    <% simulations.each do |simulation| %>
      <tr>
        <td>
          <%= link_to simulation.name, simulation_path(simulation), class: "row-link" %>
        </td>
        <td class="hide-on-mobile">
          <%= link_to simulation_path(simulation), class: "row-link" do %>
            <span class="hide-on-mobile"><%= l(simulation.purchase_date, format: :long) %></span>
            <span class="show-on-mobile"><%= l(simulation.purchase_date, format: :default) %></span>
          <% end %>
        </td>
        <td class="hide-on-mobile">
          <%= link_to number_to_currency(simulation.total_investment), simulation_path(simulation), class: "row-link" %>
        </td>
        <%# Le cash-flow annuel, loyers moins charges : c'est lui, et non plus le loyer seul,
            qui dit ce que le bien rapporte vraiment chaque année. %>
        <td class="<%= simulation.annual_cash_flow.negative? ? 'text-danger' : 'text-success' %>">
          <%= link_to number_to_currency(simulation.annual_cash_flow), simulation_path(simulation), class: "row-link" %>
        </td>
        <td class="table-actions">
          <%= link_to "✏️", edit_simulation_path(simulation), class: "btn btn-sm btn-outline" %>
          <%= button_to "🗑️", simulation_path(simulation), method: :delete, class: "btn btn-sm btn-danger",
              form: { data: { turbo_confirm: t("views.simulations.show.confirm_delete") } } %>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>
