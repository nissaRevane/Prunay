<%# La liste compare les biens sur une seule année et un seul régime (Taxation::REVIEW_REGIME,
    Projection::REVIEW_YEAR) : ce que l'année-là laisse en poche, et ce qu'une revente à sa
    date aurait rapporté en tout. Le titre de la page dit lequel et laquelle. %>
<table class="table">
  <thead>
    <tr>
      <th><%= t("views.simulations.index.name") %></th>
      <th class="text-right"><%= t("views.simulations.index.cash_flow") %></th>
      <th class="text-right"><%= t("views.simulations.index.sale_profit") %></th>
      <th></th>
    </tr>
  </thead>
  <tbody>
    <% simulations.each do |simulation| %>
      <% year = simulation.projection(Taxation::REVIEW_REGIME).year(Projection::REVIEW_YEAR) %>
      <tr>
        <td>
          <%= link_to simulation.name, simulation_path(simulation), class: "row-link" %>
        </td>
        <td class="text-right <%= year.cash_flow.negative? ? 'text-danger' : 'text-success' %>">
          <%= link_to number_to_currency(year.cash_flow), simulation_path(simulation), class: "row-link" %>
        </td>
        <td class="text-right <%= year.sale_profit.negative? ? 'text-danger' : 'text-success' %>">
          <%= link_to number_to_currency(year.sale_profit), simulation_path(simulation), class: "row-link" %>
        </td>
        <td class="table-actions">
          <%= link_to "✏️", edit_simulation_path(simulation), class: "btn btn-sm btn-outline" %>
          <%= button_to "🗑️", simulation_path(simulation), method: :delete, class: "btn btn-sm btn-danger",
              form: { data: { turbo_confirm: t("views.simulations.show.confirm_delete") } } %>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>
