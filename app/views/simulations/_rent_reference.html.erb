<% reference = simulation.rent_reference %>
<% rate = reference&.rent_per_square_meter(simulation.property_type, simulation.surface) %>

<% if rate %>
  <p class="form-hint" data-rent-estimate-amount="<%= Assumptions.whole(simulation.proposed_rent) %>">
    <%= t("views.simulations.reference.rent_html", city: reference.city,
          rate: number_to_currency(rate, unit: "€/m²"),
          link: link_to(t("views.simulations.reference.source"), RentReference::SOURCE_URL,
                        target: "_blank", rel: "noopener")) %>
  </p>
<% elsif simulation.city.present? && RentReference.covers?(simulation.property_type) %>
  <p class="form-hint"><%= t("views.simulations.reference.missing") %></p>
<% end %>
