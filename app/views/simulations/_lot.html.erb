<div class="lot-row" data-lots-target="row">
  <%= number_field_tag "#{f.object_name}[lots][][surface]", lot["surface"], id: nil, step: "0.01", min: "0.01",
      class: "form-control", required: true, disabled: disabled,
      aria: { label: Simulation.human_attribute_name(:surface) },
      data: { lots_target: "surface", action: "input->lots#refresh" } %>
  <%= number_field_tag "#{f.object_name}[lots][][monthly_rent]", lot["monthly_rent"], id: nil, step: "0.01", min: "0",
      class: "form-control", required: true, disabled: disabled,
      aria: { label: Simulation.human_attribute_name(:monthly_rent) },
      data: { lots_target: "rent", action: "input->lots#refresh" } %>
  <button type="button" class="icon-btn" aria-label="<%= t("views.simulations.lots.remove") %>"
          data-action="lots#remove">×</button>
</div>
