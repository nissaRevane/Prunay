<%# Où part l'argent : à gauche ce que le bien a coûté jusqu'à la revente, à droite ce qu'une
    année pleine laisse. Les deux valent pour le régime en tête du classement. %>
<div class="section">
  <div class="section-header">
    <h2><%= t("views.simulations.show.breakdown_title") %></h2>
  </div>

  <p class="intro">
    <%= t("views.simulations.show.breakdown_hint", regime: t("views.simulations.show.tab_#{dashboard.regime}")) %>
  </p>

  <div class="columns">
    <div class="column">
      <h3 class="subsection-title"><%= t("views.simulations.show.breakdown_outlay", year: dashboard.exit_year) %></h3>

      <dl class="panel rows">
        <% dashboard.outlay_lines.each do |field, amount| %>
          <div class="detail-item">
            <dt class="detail-label"><%= Simulation.human_attribute_name(field) %></dt>
            <dd class="detail-value"><%= number_to_currency(amount) %></dd>
          </div>
        <% end %>

        <div class="detail-item">
          <dt class="detail-label"><%= t("views.simulations.show.breakdown_cumulative_cash_flow") %></dt>
          <dd class="detail-value"><%= number_to_currency(-dashboard.cumulative_cash_flow) %></dd>
        </div>

        <div class="detail-item detail-total">
          <dt class="detail-label"><%= t("views.simulations.show.immobilized_capital") %></dt>
          <dd class="detail-value"><%= number_to_currency(dashboard.immobilized_capital) %></dd>
        </div>
      </dl>
    </div>

    <div class="column">
      <h3 class="subsection-title"><%= t("views.simulations.show.breakdown_annual", year: dashboard.exit_year) %></h3>

      <dl class="panel rows">
        <% dashboard.annual_lines.each do |line, amount| %>
          <div class="detail-item">
            <dt class="detail-label"><%= t("views.simulations.show.breakdown_#{line}") %></dt>
            <dd class="detail-value"><%= number_to_currency(amount) %></dd>
          </div>
        <% end %>

        <div class="detail-item detail-total">
          <dt class="detail-label"><%= t("views.simulations.show.cash_flow") %></dt>
          <dd class="detail-value <%= tone(dashboard.annual_cash_flow) %>"><%= number_to_currency(dashboard.annual_cash_flow) %></dd>
        </div>
      </dl>
    </div>
  </div>
</div>
