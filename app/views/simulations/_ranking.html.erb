<%# Les régimes ouverts sur la même ligne d'arrivée : c'est ce tableau qui départage, les courbes
    ne font qu'expliquer pourquoi. %>
<div class="section">
  <div class="section-header">
    <h2><%= t("views.simulations.show.ranking_title") %></h2>
  </div>

  <div class="table-scroll">
    <table class="table ranking">
      <thead>
        <tr>
          <th><%= t("views.simulations.show.ranking_regime") %></th>
          <th class="num"><%= t("views.simulations.show.internal_rate_of_return") %></th>
          <th class="num"><%= t("views.simulations.index.monthly_cash_flow") %></th>
          <th class="num"><%= t("views.simulations.show.ranking_taxes") %></th>
          <th class="num"><%= t("views.simulations.show.immobilized_capital") %></th>
          <th class="num"><%= t("views.simulations.show.ranking_sale_profit") %></th>
        </tr>
      </thead>
      <tbody>
        <% dashboard.rows.each do |row| %>
          <%= tag.tr class: class_names("is-highlighted" => row.regime == dashboard.regime) do %>
            <td><%= t("views.simulations.show.tab_#{row.regime}") %></td>
            <td class="num <%= rate_tone(row.rate) %>"><%= internal_rate_of_return_label(row.rate) %></td>
            <td class="num <%= tone(row.monthly_cash_flow) %>"><%= euros(row.monthly_cash_flow) %></td>
            <td class="num"><%= euros(row.taxes) %></td>
            <td class="num"><%= euros(row.immobilized_capital) %></td>
            <td class="num <%= tone(row.sale_profit) %>"><%= euros(row.sale_profit) %></td>
          <% end %>
        <% end %>
      </tbody>
    </table>
  </div>
</div>
