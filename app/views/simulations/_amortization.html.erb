<%# Le tableau d'amortissement : une ligne par échéance, du premier prélèvement au solde. La
    mensualité est ce que la banque prélève - intérêts, capital et prime. %>
<div class="section">
  <% loan = simulation.loan %>
  <div class="stat-grid">
    <div class="panel stack">
      <span class="label"><%= Simulation.human_attribute_name(:borrowed_capital) %></span>
      <span class="figure"><%= number_to_currency(loan.capital) %></span>
      <span class="hint"><%= t("views.simulations.show.amortization_rate_hint",
                                    rate: number_to_percentage(loan.annual_rate, precision: 2, strip_insignificant_zeros: true)) %></span>
    </div>
    <div class="panel stack">
      <span class="label"><%= t("views.simulations.show.amortization_duration") %></span>
      <span class="figure"><%= t("views.simulations.show.payment_count", months: schedule.rows.size) %></span>
      <span class="hint"><%= t("views.simulations.show.amortization_first_payment_hint",
                                    date: l(loan.first_payment_on, format: :long)) %></span>
    </div>
    <div class="panel panel-highlight stack">
      <span class="label"><%= t("views.simulations.show.amortization_total_payment") %></span>
      <span class="figure"><%= number_to_currency(loan.total_monthly_payment) %></span>
      <span class="hint">
        <%= if loan.insurance.positive?
              t("views.simulations.show.amortization_insurance_hint", insurance: number_to_currency(loan.insurance))
            else
              t("views.simulations.show.amortization_no_insurance_hint")
            end %>
      </span>
    </div>
    <div class="panel stack">
      <span class="label"><%= t("views.simulations.show.total_loan_cost") %></span>
      <span class="figure"><%= number_to_currency(schedule.total_interest + schedule.total_insurance) %></span>
    </div>
  </div>

  <div class="table-scroll table-scroll-tall">
    <table class="table">
      <thead>
        <tr>
          <th><%= t("views.simulations.show.payment_number") %></th>
          <th><%= t("views.simulations.show.due_on") %></th>
          <th class="num"><%= t("views.simulations.show.payment") %></th>
          <th class="num"><%= t("views.simulations.show.interest") %></th>
          <th class="num"><%= t("views.simulations.show.principal") %></th>
          <th class="num"><%= t("views.simulations.show.insurance") %></th>
          <th class="num"><%= t("views.simulations.show.remaining_capital") %></th>
        </tr>
      </thead>
      <tbody>
        <% schedule.rows.each do |row| %>
          <tr>
            <td><%= row.number %></td>
            <td>
              <span class="hide-on-mobile"><%= l(row.due_on, format: :long) %></span>
              <span class="show-on-mobile"><%= l(row.due_on, format: :default) %></span>
            </td>
            <td class="num"><%= number_to_currency(row.payment) %></td>
            <td class="num"><%= number_to_currency(row.interest) %></td>
            <td class="num"><%= number_to_currency(row.principal) %></td>
            <td class="num"><%= number_to_currency(row.insurance) %></td>
            <td class="num"><%= number_to_currency(row.remaining_capital) %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>
