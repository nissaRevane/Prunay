<%# Le tableau d'amortissement : une ligne par échéance, du premier prélèvement au solde du
    prêt. La mensualité y est ce que la banque prélève — intérêts, capital et prime
    d'assurance. L'onglet titre déjà le tableau ; la section n'en remet pas un en-tête. %>
<div class="section">
  <%# Ce que le crédit engage, avant le détail ligne à ligne : ce qui est emprunté, sur
      combien d'échéances, et ce que la banque prélève chaque mois — prime comprise. %>
  <% loan = simulation.loan %>
  <div class="stat-grid">
    <div class="stat-card">
      <span class="stat-label"><%= Simulation.human_attribute_name(:borrowed_capital) %></span>
      <span class="stat-value"><%= number_to_currency(loan.capital) %></span>
      <span class="stat-hint"><%= t("views.simulations.show.amortization_rate_hint",
                                    rate: number_to_percentage(loan.annual_rate, precision: 2, strip_insignificant_zeros: true)) %></span>
    </div>
    <div class="stat-card">
      <span class="stat-label"><%= t("views.simulations.show.amortization_duration") %></span>
      <span class="stat-value"><%= t("views.simulations.show.payment_count", months: schedule.rows.size) %></span>
      <span class="stat-hint"><%= t("views.simulations.show.amortization_first_payment_hint",
                                    date: l(loan.first_payment_on, format: :long)) %></span>
    </div>
    <div class="stat-card stat-card-highlight">
      <span class="stat-label"><%= t("views.simulations.show.amortization_total_payment") %></span>
      <span class="stat-value"><%= number_to_currency(loan.total_monthly_payment) %></span>
      <span class="stat-hint">
        <%= if loan.insurance.positive?
              t("views.simulations.show.amortization_insurance_hint", insurance: number_to_currency(loan.insurance))
            else
              t("views.simulations.show.amortization_no_insurance_hint")
            end %>
      </span>
    </div>
  </div>

  <div class="table-scroll table-scroll-tall">
    <table class="table table-compact">
      <thead>
        <tr>
          <th><%= t("views.simulations.show.payment_number") %></th>
          <th><%= t("views.simulations.show.due_on") %></th>
          <th class="text-right"><%= t("views.simulations.show.payment") %></th>
          <th class="text-right"><%= t("views.simulations.show.interest") %></th>
          <th class="text-right"><%= t("views.simulations.show.principal") %></th>
          <th class="text-right"><%= t("views.simulations.show.insurance") %></th>
          <th class="text-right"><%= t("views.simulations.show.remaining_capital") %></th>
        </tr>
      </thead>
      <tbody>
        <% schedule.rows.each do |row| %>
          <tr>
            <td><%= row.number %></td>
            <td>
              <span class="hide-on-mobile"><%= l(row.due_on, format: :long) %></span>
              <span class="show-on-mobile"><%= l(row.due_on, format: :default) %></span>
            </td>
            <td class="text-right"><%= number_to_currency(row.payment) %></td>
            <td class="text-right text-danger"><%= number_to_currency(row.interest) %></td>
            <td class="text-right"><%= number_to_currency(row.principal) %></td>
            <td class="text-right text-danger"><%= number_to_currency(row.insurance) %></td>
            <td class="text-right"><%= number_to_currency(row.remaining_capital) %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>

  <%# Ce que le financement coûte en tout : les intérêts du capital et les primes de
      l'assurance, que la dernière ligne du tableau additionne. %>
  <div class="section-total">
    <span><%= t("views.simulations.show.total_loan_cost") %></span>
    <span><%= number_to_currency(schedule.total_interest + schedule.total_insurance) %></span>
  </div>
</div>
