<%# Ce que le LMNP amortit chaque année, et lui seul. Rien ne s'y corrige ; le plafond et le
    report se lisent dans le détail de l'impôt de l'année. %>
<%= tag.div class: "section", hidden: true, data: regime_scope(:lmnp) do %>
  <div class="section-header">
    <h2><%= t("views.simulations.show.depreciation_plan_detail") %></h2>
  </div>

  <dl class="rows sum">
    <% plan.bases.reject { |_, base| base.zero? }.each_key do |component| %>
      <div class="detail-item">
        <dt class="detail-label">
          <%= t("views.simulations.show.depreciation_plan_#{component}",
                share: rate_label((1 - Taxation::DepreciationPlan::LAND_SHARE) * 100)) %>
          <span class="detail-note">
            <%= t("views.simulations.show.depreciation_plan_hint",
                  base: number_to_currency(plan.bases.fetch(component)),
                  years: Taxation::DepreciationPlan::COMPONENTS.fetch(component)) %>
          </span>
        </dt>
        <dd class="detail-value"><%= number_to_currency(plan.annuity(component)) %></dd>
      </div>
    <% end %>

    <% plan.capitalized(1).each do |component, tranche| %>
      <div class="detail-item">
        <dt class="detail-label">
          <%= t("views.simulations.show.depreciation_plan_capitalized_#{component}",
                share: capitalized_share_label(component)) %>
          <span class="detail-note">
            <%= t("views.simulations.show.depreciation_plan_tranche_hint", base: number_to_currency(tranche),
                  years: Taxation::DepreciationPlan::COMPONENTS.fetch(component)) %>
          </span>
        </dt>
        <dd class="detail-value"><%= number_to_currency(plan.capitalized_annuity(component)) %></dd>
      </div>
    <% end %>

    <div class="detail-item sum-total">
      <dt class="detail-label"><%= t("views.simulations.show.depreciation_plan_total") %></dt>
      <dd class="detail-value"><%= number_to_currency(plan.total(1)) %></dd>
    </div>
  </dl>
<% end %>
