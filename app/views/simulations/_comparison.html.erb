<%# Les quatre régimes sur les mêmes axes : ce qui reste engagé, ce que revendre laisserait, et
    le taux rendu. C'est le croisement du zéro qui départage. %>
<% SimulationsHelper::COMPARISON_MEASURES.each do |measure| %>
  <div class="section">
    <div class="section-header">
      <h2><%= t("views.simulations.show.comparison_#{measure}") %></h2>
    </div>
    <%= render "simulations/chart", chart: comparison_chart(projections, measure),
               title: t("views.simulations.show.comparison_#{measure}"), measure: measure %>
  </div>
<% end %>

<div class="section">
  <%= render "simulations/tax_burden", simulation: simulation, projections: projections, exit_year: exit_year %>
</div>
