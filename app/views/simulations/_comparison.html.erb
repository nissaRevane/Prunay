<%# Les quatre régimes sur les mêmes axes : ce qui reste engagé année après année, et ce que
    revendre cette année-là laisserait. C'est le croisement du zéro qui départage. %>
<% SimulationsHelper::COMPARISON_MEASURES.each do |measure| %>
  <div class="section">
    <div class="section-header">
      <h2><%= t("views.simulations.show.comparison_#{measure}") %></h2>
    </div>
    <p class="section-hint"><%= t("views.simulations.show.comparison_#{measure}_hint") %></p>

    <%= render "simulations/chart", chart: comparison_chart(projections, measure),
               title: t("views.simulations.show.comparison_#{measure}"),
               signed: measure != :immobilized_capital %>
  </div>
<% end %>
