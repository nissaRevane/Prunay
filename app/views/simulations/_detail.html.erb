<%# La fiche entière, en-tête comprise : tout y est dérivé, et une valeur corrigée dans un
    onglet en refait plusieurs ailleurs. Le serveur la renvoie donc d'un bloc. %>
<div class="page-header">
  <div>
    <div class="page-title">
      <h1><%= simulation.name %></h1>
      <%= energy_rating_badge(simulation) %>
    </div>

    <%= render "simulations/summary", simulation: simulation %>
  </div>
</div>

<%# Tous les panneaux sont rendus par le serveur ; `tab` dit lequel s'ouvre au chargement. %>
<% panels = simulation_panels(schedule) %>
<% opened = panels.include?(tab) ? tab : panels.first %>

<div data-controller="tabs" data-tabs-name-value="<%= opened %>" data-tabs-regime-value="<%= opened_regime(opened) %>"
     data-action="click@window->tabs#closeOutside keydown.esc->tabs#closeOptions">
  <div class="tabs simulation-tabs" role="tablist">
    <% simulation_tabs(schedule).each do |name| %>
      <% if taxation_tab?(name) %>
        <%= render "simulations/regime_tab", regime: opened_regime(opened), opened: opened %>
      <% else %>
        <button type="button" class="tab" role="tab" id="tab-<%= name %>"
                aria-controls="panel-<%= name %>" aria-selected="<%= name == opened %>"
                data-tabs-target="tab" data-tab-name="<%= name %>" data-action="click->tabs#select">
          <%= t("views.simulations.show.tab_#{name}") %>
        </button>
      <% end %>
    <% end %>
  </div>

  <% panels.each do |name| %>
    <%= tag.div class: "tab-panel", role: "tabpanel", id: "panel-#{name}",
                aria: { labelledby: panel_label_id(name) },
                data: { tabs_target: "panel", tab_name: name }, hidden: name != opened do %>
      <%= render "simulations/#{name}", simulation: simulation, projections: projections, schedule: schedule %>
    <% end %>
  <% end %>
</div>
