<%# Un bien de la liste : son meilleur TRI, le régime et l'année qui le donnent, et le cash-flow
    mensuel. Sur la liste, une case le désigne pour une suppression groupée. %>
<% best = simulation.best_return %>
<article class="panel panel-link stack simulation-card">
  <% if local_assigns[:selectable] %>
    <label class="simulation-card-select">
      <input type="checkbox" name="ids[]" value="<%= simulation.id %>"
             aria-label="<%= t("views.simulations.index.select_card", name: simulation.name) %>"
             data-selection-target="item" data-action="selection#refresh">
    </label>
  <% end %>
  <header class="panel-header">
    <hgroup>
      <h2 class="panel-title">
        <%= link_to simulation.name, simulation_path(simulation), class: "panel-link-target",
            data: { turbo_frame: "_top" } %>
      </h2>
      <p class="hint">
        <%= t("views.simulations.index.purchased_on", date: l(simulation.purchase_date, format: :abbr_month_year)) %>
      </p>
    </hgroup>
    <% if best.found? %>
      <span class="num">
        <span class="label"><%= t("views.simulations.index.rate") %></span>
        <span class="figure <%= rate_tone(best.rate) %>"><%= internal_rate_of_return_label(best.rate) %></span>
      </span>
    <% end %>
  </header>

  <% if simulation.address.present? %>
    <p class="hint"><%= simulation.address %></p>
  <% end %>

  <% if best.found? %>
    <p class="hint">
      <strong>
        <%= t("views.simulations.index.under_regime", regime: t("views.simulations.show.tab_#{best.regime}")) %>
      </strong>
      <span><%= t("views.simulations.index.best_exit", date: best.date.year, year: best.year) %></span>
    </p>

    <dl class="rows panel-footer">
      <div class="detail-item">
        <dt class="detail-label">
          <%= t("views.simulations.index.monthly_cash_flow") %>
          <span class="note"><%= t("views.simulations.index.first_full_year") %></span>
        </dt>
        <dd class="detail-value <%= tone(best.monthly_cash_flow) %>"><%= euros(best.monthly_cash_flow) %></dd>
      </div>
    </dl>
  <% else %>
    <p class="hint"><%= t("views.simulations.index.no_best_exit") %></p>
  <% end %>
</article>
