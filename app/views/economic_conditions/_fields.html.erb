<%# Les trois taux, dans le même ordre partout : les loyers, le bien, puis les charges. Le
    même partiel sert aux conditions par défaut et à celles d'une simulation — ce sont les
    mêmes colonnes des deux côtés. %>
<div class="form-group">
  <%= f.label :rent_growth_rate %>
  <%= f.number_field :rent_growth_rate, step: "0.01", min: EconomicConditions::MIN_RATE,
      max: EconomicConditions::MAX_RATE, class: "form-control", required: true %>
  <p class="form-hint"><%= t("views.economic_conditions.fields.rent_growth_rate_hint") %></p>
</div>

<div class="form-group">
  <%= f.label :property_growth_rate %>
  <%= f.number_field :property_growth_rate, step: "0.01", min: EconomicConditions::MIN_RATE,
      max: EconomicConditions::MAX_RATE, class: "form-control", required: true %>
  <p class="form-hint"><%= t("views.economic_conditions.fields.property_growth_rate_hint") %></p>
</div>

<div class="form-group">
  <%= f.label :inflation_rate %>
  <%= f.number_field :inflation_rate, step: "0.01", min: EconomicConditions::MIN_RATE,
      max: EconomicConditions::MAX_RATE, class: "form-control", required: true %>
  <p class="form-hint"><%= t("views.economic_conditions.fields.inflation_rate_hint") %></p>
</div>
