<nav class="navbar" data-controller="navbar"
     data-action="click@window->navbar#closeOnOutsideClick keydown.esc@window->navbar#closeOnEscape">
  <div class="navbar-brand">
    <% if user_signed_in? %>
      <%= link_to "Prunay", authenticated_root_path, class: "navbar-logo" %>
    <% else %>
      <%= link_to "Prunay", root_path, class: "navbar-logo" %>
    <% end %>
  </div>

  <%# La marque ouvre l'accueil, d'où la liste des simulations dans le menu. %>
  <% if user_signed_in? %>
    <button type="button" class="navbar-burger" aria-label="<%= t("views.nav.menu") %>"
            aria-expanded="false" aria-controls="navbar-menu"
            data-navbar-target="burger" data-action="click->navbar#toggle">
      <span class="navbar-burger-bar"></span>
      <span class="navbar-burger-bar"></span>
      <span class="navbar-burger-bar"></span>
    </button>

    <div class="navbar-menu" id="navbar-menu" data-navbar-target="menu">
      <%= link_to t("views.nav.simulations"), simulations_path, class: "nav-link" %>
      <%= link_to t("views.nav.assumptions"), edit_assumptions_path, class: "nav-link" %>
      <%= link_to current_user.full_name, account_path, class: "nav-user-name" %>
      <%= button_to t("views.nav.sign_out"), destroy_user_session_path, method: :delete, class: "btn btn-outline btn-sm" %>
    </div>
  <% else %>
    <div class="navbar-menu">
      <%= link_to t("views.nav.sign_in"), new_user_session_path, class: "btn btn-outline btn-sm" %>
      <%= link_to t("views.nav.sign_up"), new_user_registration_path, class: "btn btn-primary btn-sm" %>
    </div>
  <% end %>
</nav>
