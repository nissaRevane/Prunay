# Copier en .kamal/secrets (ignoré par git) et remplir.
# SECRET_KEY_BASE : openssl rand -hex 64
# POSTGRES_PASSWORD : openssl rand -hex 16
# KAMAL_REGISTRY_PASSWORD : un token GitHub avec le scope write:packages
KAMAL_REGISTRY_PASSWORD=
SECRET_KEY_BASE=
POSTGRES_PASSWORD=
DATABASE_URL=postgres://prunay:$POSTGRES_PASSWORD@prunay-db:5432/prunay_production
